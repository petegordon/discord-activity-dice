{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "discord-activity-dice",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "RelayRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RelayRoom"] }],
  "routes": [{ "pattern": "dice.jimandi.love", "custom_domain": true }],
  "vars": {
    // Public Discord application ID. The secret is set with: wrangler secret put DISCORD_CLIENT_SECRET
    "DISCORD_CLIENT_ID": ""
  }
}
